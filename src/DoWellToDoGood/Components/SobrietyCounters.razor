@using DoWellToDoGood.Models
@using DoWellToDoGood.Services
@implements IDisposable
@inject AuthService Auth
@inject CryptoService Crypto
@inject SobrietyService Svc

@* A compact, read-only view of the user's recovery counters for Home. Renders
   nothing when signed out, locked (Home's single UnlockCard covers that), or
   with no counters. Full management lives on the Recovery page. *@
@if (Auth.IsSignedIn && Crypto.IsUnlocked && _items.Count > 0)
{
    <div class="card space-y-3 mb-6">
        <div class="flex items-center justify-between gap-2 flex-wrap">
            <h2 class="m-0 text-base font-bold">Your recovery</h2>
            <a class="text-sm font-semibold" href="recovery">Manage →</a>
        </div>
        <ul class="space-y-2 m-0 pl-0" style="list-style:none">
            @foreach (var it in _items)
            {
                <li class="flex items-baseline justify-between gap-3 flex-wrap rounded-bubble bg-surface-2 border border-line p-3">
                    <span class="font-semibold">@it.Name</span>
                    <span class="text-sm whitespace-nowrap">
                        <span class="font-bold">@it.Days</span> <span class="text-muted">@(it.Days == 1 ? "day" : "days")</span>
                        @if (it.Milestone)
                        {
                            <span class="badge ml-2">🎉 @it.MilestoneLabel</span>
                        }
                    </span>
                </li>
            }
        </ul>
    </div>
}

@code {
    private List<Item> _items = new();
    private sealed record Item(string Name, int Days, bool Milestone, string MilestoneLabel);

    protected override void OnInitialized()
    {
        Auth.Changed += OnChanged;
        Crypto.Changed += OnChanged;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (!Auth.IsSignedIn || !Crypto.IsUnlocked) { _items = new(); return; }
        try
        {
            var rows = await Svc.ListCountersAsync();

            var today = DateOnly.FromDateTime(DateTime.Today);
            var items = new List<Item>();
            foreach (var r in rows)
            {
                try
                {
                    // Only the name and clean-since are shown here; the rest of the
                    // counter is parsed and ignored so both views share one codec.
                    var counter = SobrietyCounterPayload.Parse(await Crypto.DecryptAsync(r.Payload), today);
                    var days = Milestones.DaysClean(counter.CleanSince, today);
                    items.Add(new Item(counter.Name, days, Milestones.IsMilestone(days), Milestones.Label(days)));
                }
                catch { /* skip a counter that won't decrypt */ }
            }
            _items = items;
        }
        catch { _items = new(); }
    }

    private async void OnChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.Changed -= OnChanged;
        Crypto.Changed -= OnChanged;
    }
}
