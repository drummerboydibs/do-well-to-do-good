@using System.Globalization
@implements IDisposable
@inject AuthService Auth
@inject CryptoService Crypto
@inject SleepService Svc

@* Today's sleep card: last night at a glance, or — if it isn't logged yet —
   a nudge to log it. Nights are keyed by the morning they end on, so "last
   night" is today's row. Renders nothing while locked (Today's UnlockCard
   covers that) or still loading, so the empty state never flashes. *@
@if (Auth.IsSignedIn && Crypto.IsUnlocked && _loaded)
{
    <div class="card space-y-3 mb-6">
        <div class="flex items-center justify-between gap-2 flex-wrap">
            <h2 class="m-0 text-base font-bold">Last night</h2>
            <a class="text-sm font-semibold" href="track/sleep">@(_night is null ? "Log it →" : "Sleep journal →")</a>
        </div>
        @if (_night is null)
        {
            <p class="m-0 text-muted">Not logged yet. A few taps each morning shows you what helps you rest.</p>
            <a class="btn btn-sm" href="track/sleep">Log last night</a>
        }
        else
        {
            <p class="m-0">
                @if (SleepMath.EstimatedSleepMinutes(_night) is { } mins)
                {
                    <span class="stat-num !text-2xl">@SleepMath.FormatDuration(mins)</span> <span class="text-muted">of sleep</span>
                }
                else
                {
                    <span class="text-muted">Logged — no bed or wake time.</span>
                }
            </p>
            @if (_night.Bedtime is { } b && _night.WakeTime is { } w)
            {
                <p class="m-0 text-sm text-muted">@b.ToString("h:mm tt", CultureInfo.CurrentCulture) → @w.ToString("h:mm tt", CultureInfo.CurrentCulture)</p>
            }
        }
    </div>
}

@code {
    private bool _loaded;
    private SleepNight? _night;

    protected override void OnInitialized()
    {
        Auth.Changed += OnChanged;
        Crypto.Changed += OnChanged;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loaded = false;
        _night = null;
        if (!Auth.IsSignedIn || !Crypto.IsUnlocked) return;
        var today = DateOnly.FromDateTime(DateTime.Now);
        try
        {
            if (await Svc.GetByNightAsync(today) is { } row)
                _night = SleepPayload.Parse(await Crypto.DecryptAsync(row.Payload), today);
        }
        catch { /* offline or undecryptable — show the "log it" state */ }
        _loaded = true;
    }

    private async void OnChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.Changed -= OnChanged;
        Crypto.Changed -= OnChanged;
    }
}
