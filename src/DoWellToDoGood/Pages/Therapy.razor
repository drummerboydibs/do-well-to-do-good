@page "/therapy"
@using DoWellToDoGood.Services
@inject AuthService Auth
@inject CryptoService Crypto
@inject TherapyService Svc
@inject IJSRuntime JS

<PageTitle>Therapy &amp; goals — Do Well to Do Good</PageTitle>

@* Open-goal card template (declared before use). *@
@{
    RenderFragment<GoalVm> GoalCard = g =>
    @<article class="card space-y-4">
        @if (g.Editing)
        {
            <div class="field m-0">
                <label class="label" for="edit-title-@g.Id">Goal</label>
                <input id="edit-title-@g.Id" class="input" type="text" maxlength="200" @bind="g.EditTitle" />
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <label class="text-sm text-muted" for="edit-end-@g.Id">Target date</label>
                <input id="edit-end-@g.Id" class="input !min-h-0 py-1 w-auto" type="date" @bind="g.EditEnd" />
                @if (g.EditEnd is not null)
                {
                    <button type="button" class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => g.EditEnd = null">Clear date</button>
                }
            </div>
            <div class="flex gap-2">
                <button class="btn btn-primary !min-h-0 py-2" @onclick="() => SaveEdit(g)">Save</button>
                <button class="btn btn-ghost !min-h-0 py-2" @onclick="() => g.Editing = false">Cancel</button>
            </div>
        }
        else
        {
            <header class="flex justify-between items-start gap-3 flex-wrap">
                <div>
                    <h3 class="m-0">@g.Title</h3>
                    @if (g.End is not null)
                    {
                        <p class="text-sm m-0 mt-1 @(IsOverdue(g) ? "font-semibold" : "text-muted")"
                           style="@(IsOverdue(g) ? "color:var(--color-danger)" : "")">
                            @(IsOverdue(g) ? "⚠ Was due " : "Target: ")@FormatDate(g.End.Value)
                        </p>
                    }
                    else
                    {
                        <p class="text-sm text-muted m-0 mt-1">No end date</p>
                    }
                </div>
                <div class="flex gap-2">
                    <button class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => StartEdit(g)">Edit</button>
                    <button class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => SetDone(g, true)">Mark done</button>
                    <button class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => DeleteGoal(g)">Delete</button>
                </div>
            </header>

            @if (g.Progress.Count > 0)
            {
                <ul class="space-y-2 m-0 pl-0" style="list-style:none">
                    @foreach (var p in g.Progress)
                    {
                        <li class="rounded-bubble bg-surface-2 border border-line p-3">
                            <div class="flex justify-between items-baseline gap-2 flex-wrap">
                                <span class="text-xs text-muted">@FormatDate(p.Date)</span>
                                <button class="btn btn-ghost text-xs !min-h-0 !py-0.5 !px-1.5" @onclick="() => DeleteProgress(g, p)">Remove</button>
                            </div>
                            <p class="m-0 mt-1 whitespace-pre-wrap">@p.Note</p>
                        </li>
                    }
                </ul>
            }

            <div class="card-soft space-y-3">
                <label class="label text-sm m-0" for="prog-@g.Id">Log progress</label>
                <textarea id="prog-@g.Id" class="textarea !min-h-[4rem]" rows="2" maxlength="5000"
                          placeholder="What happened? e.g. Introduced myself to a stranger named Sarah." @bind="g.DraftNote"></textarea>
                <div class="flex items-center gap-3 flex-wrap">
                    <input class="input !min-h-0 py-1 w-auto" type="date" max="@_today" @bind="g.DraftDate" />
                    <button class="btn btn-primary !min-h-0 py-2" disabled="@string.IsNullOrWhiteSpace(g.DraftNote)" @onclick="() => AddProgress(g)">Add</button>
                </div>
            </div>
        }
    </article>;
}

<div class="mx-auto max-w-3xl px-6 space-y-6">
    <h1>Therapy &amp; goals</h1>

    <SobrietyCounters />

    @if (!Auth.IsSignedIn)
    {
        <div class="card text-center space-y-4">
            <p class="text-muted m-0">Sign in to log therapy sessions and track goals — encrypted so only you can read them.</p>
            <a class="btn btn-primary" href="signin">Sign in</a>
        </div>
    }
    else if (!Crypto.IsUnlocked)
    {
        <VaultGate OnUnlocked="Load" />
    }
    else if (_loading)
    {
        <p class="text-muted" role="status">Decrypting your sessions and goals…</p>
    }
    else
    {
        @* ---------- Log a session ---------- *@
        <section class="card space-y-4" aria-labelledby="log-h">
            <h2 id="log-h" class="m-0">Log a therapy session</h2>

            <div class="field">
                <label class="label" for="s-date">Session date</label>
                <input id="s-date" class="input" type="date" max="@_today" @bind="_sessionDate" />
            </div>

            <div class="field">
                <label class="label" for="s-notes">Session notes</label>
                <textarea id="s-notes" class="textarea" rows="5" maxlength="20000" @bind="_sessionNotes"
                          placeholder="What came up, what helped, anything you want to remember…"></textarea>
            </div>

            <div class="space-y-3">
                <p class="label m-0">Goals from this session <span class="text-muted font-normal">(optional, up to 4)</span></p>
                @for (int i = 0; i < _goalDrafts.Count; i++)
                {
                    var d = _goalDrafts[i];
                    <div class="card-soft space-y-3">
                        <div class="flex justify-between items-center gap-2">
                            <span class="font-semibold text-sm">Goal @(i + 1)</span>
                            <button type="button" class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => RemoveGoalDraft(d)">Remove</button>
                        </div>
                        <input class="input" type="text" maxlength="200" placeholder="e.g. Introduce yourself to two strangers" @bind="d.Title" />
                        <div class="flex items-center gap-3 flex-wrap">
                            <label class="text-sm text-muted" for="g-end-@i">Target date (optional)</label>
                            <input id="g-end-@i" class="input !min-h-0 py-1 w-auto" type="date" min="@_today" @bind="d.End" />
                            @if (d.End is not null)
                            {
                                <button type="button" class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => d.End = null">Clear date</button>
                            }
                        </div>
                    </div>
                }
                @if (_goalDrafts.Count < 4)
                {
                    <button type="button" class="btn !min-h-0 py-2" @onclick="AddGoalDraft">+ Add a goal</button>
                }
            </div>

            @if (_sessionError is not null)
            {
                <p class="text-sm font-semibold m-0" style="color:var(--color-danger)" role="alert">@_sessionError</p>
            }
            @if (_sessionSaved)
            {
                <p class="text-sm font-semibold m-0" style="color:var(--color-success)" role="status">Session logged. 🌱</p>
            }
            <button class="btn btn-primary" disabled="@_savingSession" @onclick="SaveSession">
                @(_savingSession ? "Encrypting & saving…" : "Log session")
            </button>
        </section>

        @* ---------- Open goals ---------- *@
        <section class="space-y-4" aria-labelledby="goals-h">
            <div class="flex items-center justify-between gap-3 flex-wrap">
                <h2 id="goals-h" class="m-0">Open goals</h2>
                @if (!_showAddGoal)
                {
                    <button type="button" class="btn !min-h-0 py-2" aria-label="Add a standalone goal" @onclick="ToggleAddGoal">+ Add a goal</button>
                }
            </div>

            @if (_showAddGoal)
            {
                <div class="card-soft space-y-3">
                    <div class="field m-0">
                        <label class="label" for="new-goal-title">Goal</label>
                        <input id="new-goal-title" class="input" type="text" maxlength="200"
                               placeholder="e.g. Take a walk outside three times this week" @bind="_newGoalTitle" />
                    </div>
                    <div class="flex items-center gap-3 flex-wrap">
                        <label class="text-sm text-muted" for="new-goal-end">Target date (optional)</label>
                        <input id="new-goal-end" class="input !min-h-0 py-1 w-auto" type="date" min="@_today" @bind="_newGoalEnd" />
                        @if (_newGoalEnd is not null)
                        {
                            <button type="button" class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => _newGoalEnd = null">Clear date</button>
                        }
                    </div>
                    @if (_sessionOptions.Count > 0)
                    {
                        <div class="field m-0">
                            <label class="label" for="new-goal-session">Link to a session <span class="text-muted font-normal">(optional)</span></label>
                            <select id="new-goal-session" class="input" @bind="_newGoalSessionKey">
                                <option value="">Not linked to a session</option>
                                @foreach (var o in _sessionOptions)
                                {
                                    <option value="@o.Id">@FormatDate(DateOnly.FromDateTime(o.CreatedAt.LocalDateTime))</option>
                                }
                            </select>
                        </div>
                    }
                    @if (_addGoalError is not null)
                    {
                        <p class="text-sm font-semibold m-0" style="color:var(--color-danger)" role="alert">@_addGoalError</p>
                    }
                    <div class="flex gap-2">
                        <button class="btn btn-primary !min-h-0 py-2" disabled="@_savingGoal" @onclick="SaveNewGoal">
                            @(_savingGoal ? "Encrypting & saving…" : "Save goal")
                        </button>
                        <button class="btn btn-ghost !min-h-0 py-2" disabled="@_savingGoal" @onclick="ToggleAddGoal">Cancel</button>
                    </div>
                </div>
            }

            @if (_openGoals.Count == 0 && !_showAddGoal)
            {
                <div class="card-soft text-muted">No open goals yet. Add one when you log a session above, or with “+ Add a goal”.</div>
            }
            @foreach (var g in _openGoals)
            {
                @GoalCard(g)
            }
        </section>

        @if (_doneGoals.Count > 0)
        {
            <details class="card-soft">
                <summary class="font-semibold cursor-pointer">Completed goals (@_doneGoals.Count)</summary>
                <div class="space-y-3 mt-3">
                    @foreach (var g in _doneGoals)
                    {
                        <div class="rounded-bubble border border-line p-3 flex justify-between items-center gap-3 flex-wrap">
                            <span class="line-through text-muted">@g.Title</span>
                            <span class="flex gap-2">
                                <button class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => SetDone(g, false)">Reopen</button>
                                <button class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => DeleteGoal(g)">Delete</button>
                            </span>
                        </div>
                    }
                </div>
            </details>
        }

        @if (_sessionTotal > 0)
        {
            <details class="card-soft">
                <summary class="font-semibold cursor-pointer">Past sessions (@_sessionTotal)</summary>
                <div class="space-y-4 mt-3">
                    @foreach (var s in _sessions)
                    {
                        <article class="rounded-bubble border border-line p-4 space-y-2">
                            @if (s.Editing)
                            {
                                <div class="field m-0">
                                    <label class="label" for="edit-s-date-@s.Id">Session date</label>
                                    <input id="edit-s-date-@s.Id" class="input" type="date" max="@_today" @bind="s.EditDate" />
                                </div>
                                <div class="field m-0">
                                    <label class="label" for="edit-s-notes-@s.Id">Session notes</label>
                                    <textarea id="edit-s-notes-@s.Id" class="textarea" rows="5" maxlength="20000" @bind="s.EditNotes"></textarea>
                                </div>
                                @if (s.Error is not null)
                                {
                                    <p class="text-sm font-semibold m-0" style="color:var(--color-danger)" role="alert">@s.Error</p>
                                }
                                <div class="flex gap-2">
                                    <button class="btn btn-primary !min-h-0 py-2" disabled="@(s.Saving || string.IsNullOrWhiteSpace(s.EditNotes))" @onclick="() => SaveSessionEdit(s)">
                                        @(s.Saving ? "Encrypting & saving…" : "Save")
                                    </button>
                                    <button class="btn btn-ghost !min-h-0 py-2" disabled="@s.Saving" @onclick="() => CancelSessionEdit(s)">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <header class="flex justify-between items-baseline gap-3 flex-wrap">
                                    <span class="font-bold">@FormatDate(s.Date)</span>
                                    <span class="flex gap-2">
                                        @if (s.Decryptable)
                                        {
                                            <button class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => StartSessionEdit(s)">Edit</button>
                                        }
                                        <button class="btn btn-ghost text-sm !min-h-0 !py-1 !px-2" @onclick="() => DeleteSession(s)">Delete</button>
                                    </span>
                                </header>
                                @if (!string.IsNullOrWhiteSpace(s.Notes))
                                {
                                    <p class="m-0 whitespace-pre-wrap">@s.Notes</p>
                                }
                                @if (s.GoalTitles.Count > 0)
                                {
                                    <p class="text-sm text-muted m-0">Goals set: @string.Join(", ", s.GoalTitles)</p>
                                }
                                @if (s.UpdatedAt is { } edited)
                                {
                                    <p class="text-xs text-muted m-0">Edited @FormatEditedOn(edited)</p>
                                }
                            }
                        </article>
                    }
                </div>

                @if (_sessionTotal > SessionPageSize)
                {
                    <nav class="flex items-center justify-center gap-3 flex-wrap mt-4" aria-label="Past session pages">
                        <button class="btn" disabled="@(_sessionPage <= 1)" @onclick="() => GoToSessionsPage(_sessionPage - 1)" aria-label="Show newer sessions">
                            <span aria-hidden="true">←</span> Newer
                        </button>
                        <span class="text-muted text-sm" aria-live="polite">Page @_sessionPage of @Pagination.TotalPages(_sessionTotal, SessionPageSize)</span>
                        <button class="btn" disabled="@(_sessionPage >= Pagination.TotalPages(_sessionTotal, SessionPageSize))" @onclick="() => GoToSessionsPage(_sessionPage + 1)" aria-label="Show older sessions">
                            Older <span aria-hidden="true">→</span>
                        </button>
                    </nav>
                }
            </details>
        }
    }
</div>

@code {
    private bool _loading = true;
    private readonly string _today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    // What a payload with no usable date falls back to.
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    // Log-session form
    private DateOnly _sessionDate = DateOnly.FromDateTime(DateTime.Today);
    private string _sessionNotes = "";
    private readonly List<GoalDraft> _goalDrafts = new() { new() };
    private bool _savingSession, _sessionSaved;
    private string? _sessionError;

    // Standalone "add a goal" (outside the session editor). Optionally tied to a past session.
    private bool _showAddGoal;
    private string _newGoalTitle = "";
    private DateOnly? _newGoalEnd;
    private string _newGoalSessionKey = "";  // "" = not linked; otherwise a session id
    private bool _savingGoal;
    private string? _addGoalError;

    private List<GoalVm> _openGoals = new();
    private List<GoalVm> _doneGoals = new();

    // Past sessions are paginated (they can pile up). The goal titles created by
    // each session are keyed here from the full goal list so any page can look
    // them up without refetching.
    private List<SessionVm> _sessions = new();
    private Dictionary<Guid, List<string>> _goalTitleBySession = new();
    private int _sessionTotal;
    private int _sessionPage = 1;
    private const int SessionPageSize = 20;

    // Every session (id + logged date only), for the "link to a session" picker.
    // Deliberately independent of the page above: the picker must offer all
    // sessions, not just the ones currently paged into view.
    private List<TherapyService.SessionOption> _sessionOptions = new();

    private sealed class GoalDraft { public string Title = ""; public DateOnly? End; }

    private sealed class GoalVm
    {
        public Guid Id;
        public string Title = "";
        public DateOnly? End;
        public bool Done;
        public DateTimeOffset CreatedAt;
        public List<ProgressVm> Progress = new();
        // UI state
        public bool Editing;
        public string EditTitle = "";
        public DateOnly? EditEnd;
        public string DraftNote = "";
        public DateOnly DraftDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private sealed record ProgressVm(Guid Id, string Note, DateOnly Date, DateTimeOffset CreatedAt);

    private sealed class SessionVm
    {
        public Guid Id;
        public DateOnly Date;
        public string Notes = "";
        public DateTimeOffset? UpdatedAt;
        public List<string> GoalTitles = new();
        public bool Decryptable = true;   // false → don't offer Edit (would clobber the ciphertext)
        // UI state
        public bool Editing;
        public DateOnly EditDate;
        public string EditNotes = "";
        public bool Saving;
        public string? Error;
    }

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsSignedIn && Crypto.IsUnlocked) await Load();
        else _loading = false;
    }

    private async Task Load()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var goalRows = await Svc.ListGoalsAsync(openOnly: false);
            var progressRows = await Svc.ListAllProgressAsync();

            // Decrypt progress and bucket by goal.
            var progressByGoal = new Dictionary<Guid, List<ProgressVm>>();
            foreach (var p in progressRows)
            {
                var (note, date) = await DecryptProgress(p.Payload);
                if (!progressByGoal.TryGetValue(p.GoalId, out var list))
                    progressByGoal[p.GoalId] = list = new();
                list.Add(new ProgressVm(p.Id, note, date, p.CreatedAt));
            }

            // Decrypt goals.
            var goals = new List<GoalVm>();
            foreach (var row in goalRows)
            {
                var (title, legacyEnd) = await DecryptGoal(row.Payload);
                goals.Add(new GoalVm
                {
                    Id = row.Id,
                    Title = title,
                    End = row.EndDate ?? legacyEnd,   // prefer the plaintext column; fall back for legacy goals
                    Done = row.Done,
                    CreatedAt = row.CreatedAt,
                    Progress = progressByGoal.TryGetValue(row.Id, out var pr)
                        ? pr.OrderByDescending(x => x.CreatedAt).ToList()
                        : new()
                });
            }

            _openGoals = goals.Where(g => !g.Done)
                .OrderBy(g => g.End ?? DateOnly.MaxValue)
                .ThenByDescending(g => g.CreatedAt)
                .ToList();
            _doneGoals = goals.Where(g => g.Done).OrderByDescending(g => g.CreatedAt).ToList();

            // Map goal titles to the session that created them, so any session
            // page can show its "Goals set" line without refetching goals.
            _goalTitleBySession = new();
            foreach (var row in goalRows)
            {
                if (row.SessionId is { } sid)
                {
                    var title = goals.First(g => g.Id == row.Id).Title;
                    if (!_goalTitleBySession.TryGetValue(sid, out var l)) _goalTitleBySession[sid] = l = new();
                    l.Add(title);
                }
            }

            _sessionOptions = await Svc.ListSessionOptionsAsync();
            await LoadSessionsPage(1);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSessionsPage(int page)
    {
        var pageData = await Svc.ListSessionsPageAsync((page - 1) * SessionPageSize, SessionPageSize);
        _sessionTotal = pageData.Total;

        // A deletion can leave us past the last page; fall back to the new last one.
        var lastPage = Pagination.TotalPages(_sessionTotal, SessionPageSize);
        if (page > lastPage)
        {
            await LoadSessionsPage(lastPage);
            return;
        }
        _sessionPage = page;

        var sessions = new List<SessionVm>();
        foreach (var s in pageData.Rows)
        {
            var (date, notes, ok) = await DecryptSession(s.Payload);
            sessions.Add(new SessionVm
            {
                Id = s.Id,
                Date = date,
                Notes = notes,
                UpdatedAt = s.UpdatedAt,
                Decryptable = ok,
                GoalTitles = _goalTitleBySession.TryGetValue(s.Id, out var t) ? t : new()
            });
        }
        _sessions = sessions; // server already returned them newest-first by created_at
    }

    private Task GoToSessionsPage(int page) =>
        LoadSessionsPage(Pagination.ClampPage(page, _sessionTotal, SessionPageSize));

    private async Task SaveSession()
    {
        _sessionError = null;
        _sessionSaved = false;
        if (string.IsNullOrWhiteSpace(_sessionNotes))
        {
            _sessionError = "Add a few notes about the session before logging it.";
            return;
        }
        _savingSession = true;
        try
        {
            var sessionPayload = TherapySessionPayload.Serialize(new TherapySession(_sessionDate, _sessionNotes));
            var blob = await Crypto.EncryptAsync(sessionPayload);
            var sessionId = await Svc.InsertSessionAsync(blob);

            foreach (var d in _goalDrafts.Where(d => !string.IsNullOrWhiteSpace(d.Title)))
            {
                var gblob = await Crypto.EncryptAsync(GoalPayload.Serialize(d.Title.Trim()));
                await Svc.InsertGoalAsync(sessionId, gblob, d.End);
            }
        }
        catch
        {
            _sessionError = "Couldn't save your session. Check your connection and try again.";
            return; // leave the form (and the user's notes) intact so the error stays put
        }
        finally
        {
            _savingSession = false;
        }

        // Only past a successful save: reset the form and refresh. Reload outside
        // the try so a reload failure can't be reported as a save failure.
        _sessionNotes = "";
        _sessionDate = DateOnly.FromDateTime(DateTime.Today);
        _goalDrafts.Clear();
        _goalDrafts.Add(new());
        _sessionSaved = true;
        await Load();
    }

    private void ToggleAddGoal()
    {
        _showAddGoal = !_showAddGoal;
        if (!_showAddGoal) ResetAddGoalForm();
    }

    private void ResetAddGoalForm()
    {
        _newGoalTitle = "";
        _newGoalEnd = null;
        _newGoalSessionKey = "";
        _addGoalError = null;
    }

    private async Task SaveNewGoal()
    {
        _addGoalError = null;
        if (string.IsNullOrWhiteSpace(_newGoalTitle))
        {
            _addGoalError = "Give the goal a short title first.";
            return;
        }

        // Snapshot the form before any await, so a mid-save Cancel/reset can't
        // change what we persist. (Cancel is also disabled while saving.)
        var title = _newGoalTitle.Trim();
        var end = _newGoalEnd;
        Guid? sessionId = Guid.TryParse(_newGoalSessionKey, out var sid) ? sid : null;

        _savingGoal = true;
        try
        {
            var blob = await Crypto.EncryptAsync(GoalPayload.Serialize(title));
            await Svc.InsertGoalAsync(sessionId, blob, end);
        }
        catch
        {
            _addGoalError = "Couldn't save the goal. Check your connection and try again.";
            return; // leave the form open so the error is visible
        }
        finally
        {
            _savingGoal = false;
        }

        // Only past a successful insert. Reload outside the try so a reload
        // failure can't masquerade as (and hide behind a closed form) a save error.
        _showAddGoal = false;
        ResetAddGoalForm();
        await Load(); // refresh so the goal appears and any linked session lists it
    }

    private void AddGoalDraft()
    {
        if (_goalDrafts.Count < 4) _goalDrafts.Add(new());
    }

    private void RemoveGoalDraft(GoalDraft d)
    {
        _goalDrafts.Remove(d);
        if (_goalDrafts.Count == 0) _goalDrafts.Add(new());
    }

    private void StartEdit(GoalVm g)
    {
        g.EditTitle = g.Title;
        g.EditEnd = g.End;
        g.Editing = true;
    }

    private async Task SaveEdit(GoalVm g)
    {
        if (string.IsNullOrWhiteSpace(g.EditTitle)) return;
        var blob = await Crypto.EncryptAsync(GoalPayload.Serialize(g.EditTitle.Trim()));
        await Svc.UpdateGoalAsync(g.Id, blob, g.EditEnd);
        g.Title = g.EditTitle.Trim();
        g.End = g.EditEnd;
        g.Editing = false;
        ResortOpen();
    }

    private async Task SetDone(GoalVm g, bool done)
    {
        await Svc.SetGoalDoneAsync(g.Id, done);
        g.Done = done;
        _openGoals = _openGoals.Where(x => x.Id != g.Id).ToList();
        _doneGoals = _doneGoals.Where(x => x.Id != g.Id).ToList();
        if (done) _doneGoals.Insert(0, g);
        else { _openGoals.Add(g); ResortOpen(); }
    }

    private async Task DeleteGoal(GoalVm g)
    {
        if (!await Confirm("Delete this goal and its progress? This can't be undone.")) return;
        await Svc.DeleteGoalAsync(g.Id); // progress cascades in the DB
        _openGoals = _openGoals.Where(x => x.Id != g.Id).ToList();
        _doneGoals = _doneGoals.Where(x => x.Id != g.Id).ToList();
    }

    private async Task AddProgress(GoalVm g)
    {
        if (string.IsNullOrWhiteSpace(g.DraftNote)) return;
        var payload = GoalProgressPayload.Serialize(new GoalProgressNote(g.DraftDate, g.DraftNote.Trim()));
        var blob = await Crypto.EncryptAsync(payload);
        await Svc.InsertProgressAsync(g.Id, blob);
        // Optimistic: show it immediately (server timestamp ~ now).
        g.Progress.Insert(0, new ProgressVm(Guid.NewGuid(), g.DraftNote.Trim(), g.DraftDate, DateTimeOffset.UtcNow));
        g.DraftNote = "";
        g.DraftDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private async Task DeleteProgress(GoalVm g, ProgressVm p)
    {
        await Svc.DeleteProgressAsync(p.Id);
        g.Progress.Remove(p);
    }

    private async Task DeleteSession(SessionVm s)
    {
        if (!await Confirm("Delete this session? Your goals from it will be kept.")) return;
        await Svc.DeleteSessionAsync(s.Id);
        _sessionOptions = await Svc.ListSessionOptionsAsync(); // drop it from the goal-link picker too
        // Reload the page so the total and pagination stay accurate (and the freed
        // slot fills from the next page); falls back a page if this emptied one.
        await LoadSessionsPage(_sessionPage);
    }

    private void StartSessionEdit(SessionVm s)
    {
        s.EditDate = s.Date;
        s.EditNotes = s.Notes;
        s.Error = null;
        s.Editing = true;
    }

    private static void CancelSessionEdit(SessionVm s)
    {
        s.Editing = false;
        s.Error = null;
    }

    private async Task SaveSessionEdit(SessionVm s)
    {
        if (string.IsNullOrWhiteSpace(s.EditNotes) || s.Saving) return;
        s.Error = null;

        // Snapshot before the first await so a mid-save Cancel can't change what
        // we persist. (Cancel is also disabled while saving.)
        var date = s.EditDate;
        var notes = s.EditNotes;

        s.Saving = true;
        DateTimeOffset editedAt;
        try
        {
            var blob = await Crypto.EncryptAsync(TherapySessionPayload.Serialize(new TherapySession(date, notes)));
            editedAt = await Svc.UpdateSessionAsync(s.Id, blob);
        }
        catch
        {
            s.Error = "Couldn't save your changes. Check your connection and try again — your edit is still here.";
            return; // stay in edit mode so the error (and the edit) are visible
        }
        finally
        {
            s.Saving = false;
        }

        s.Date = date;
        s.Notes = notes;
        s.UpdatedAt = editedAt;
        s.Editing = false;
    }

    private void ResortOpen() => _openGoals = _openGoals
        .OrderBy(g => g.End ?? DateOnly.MaxValue)
        .ThenByDescending(g => g.CreatedAt)
        .ToList();

    private bool IsOverdue(GoalVm g) => g.End is { } e && e < DateOnly.FromDateTime(DateTime.Today);

    private static string FormatDate(DateOnly d) => d.ToString("MMM d, yyyy");

    private static string FormatEditedOn(DateTimeOffset dt) => dt.LocalDateTime.ToString("MMM d, yyyy · h:mm tt");

    private Task<bool> Confirm(string message) => JS.InvokeAsync<bool>("confirm", message).AsTask();

    // ---- payload decryption helpers ----

    private async Task<(string Title, DateOnly? End)> DecryptGoal(string payload)
    {
        try
        {
            var goal = GoalPayload.Parse(await Crypto.DecryptAsync(payload));
            return (goal.Title, goal.LegacyEnd);
        }
        catch { return ("⚠ Couldn't decrypt this goal", null); }
    }

    private async Task<(string Note, DateOnly Date)> DecryptProgress(string payload)
    {
        try
        {
            var progress = GoalProgressPayload.Parse(await Crypto.DecryptAsync(payload), Today);
            return (progress.Note, progress.Date);
        }
        catch { return ("⚠ Couldn't decrypt this note", Today); }
    }

    private async Task<(DateOnly Date, string Notes, bool Ok)> DecryptSession(string payload)
    {
        try
        {
            var session = TherapySessionPayload.Parse(await Crypto.DecryptAsync(payload), Today);
            return (session.Date, session.Notes, true);
        }
        catch { return (Today, "⚠ Couldn't decrypt this session", false); }
    }
}
