@page "/signin"
@page "/account"
@using DoWellToDoGood.Models
@using DoWellToDoGood.Services
@inject AuthService Auth
@inject CryptoService Crypto
@inject ThemeService Theme
@inject FaithService Faith
@inject NavPrefsService NavPrefs
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(Auth.IsSignedIn ? "Account" : "Sign in") — Do Well to Do Good</PageTitle>

<div class="mx-auto max-w-md px-6 space-y-6">
    <div class="card space-y-4">
        <img src="icons/icon.svg" alt="" class="mx-auto w-16 h-16 drop-shadow block" width="64" height="64" />

        @if (Auth.IsSignedIn)
        {
            <div class="space-y-1">
                <h1 class="text-center">Account</h1>
                <p class="text-muted text-center m-0">@Auth.Email</p>
                @if (_createdAt.HasValue || _lastSignIn.HasValue)
                {
                    <div class="flex flex-col items-center gap-0.5">
                        @if (_createdAt.HasValue)
                        {
                            <p class="text-xs text-muted m-0">Member since @_createdAt.Value.ToLocalTime().ToString("MMMM d, yyyy")</p>
                        }
                        @if (_lastSignIn.HasValue)
                        {
                            <p class="text-xs text-muted m-0">Last login @_lastSignIn.Value.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")</p>
                        }
                    </div>
                }
            </div>

            <div class="space-y-3">
                <section aria-labelledby="appearance-heading" class="space-y-2">
                    <h2 id="appearance-heading" class="text-base font-bold m-0">Appearance</h2>
                    <fieldset class="segmented">
                        <legend class="sr-only">Color theme</legend>
                        @foreach (var opt in _themeOptions)
                        {
                            <label class="segmented-option">
                                <input type="radio" name="theme" class="sr-only" value="@opt.Value"
                                       checked="@(Theme.Current == opt.Value)"
                                       @onchange="() => SetTheme(opt.Value)" />
                                <span aria-hidden="true">@opt.Icon</span> @opt.Label
                            </label>
                        }
                    </fieldset>
                </section>

                @* Rarely changed, so folded away — unless we were sent here to change it
                   (Today's "Choose what you track" link adds ?trackers=1). *@
                <details class="disclosure" open="@(TrackersFlag is not null)">
                    <summary><span id="nav-heading" class="text-base font-bold" style="color:var(--color-ink)">Your trackers</span></summary>
                    <div class="space-y-2 pt-1">
                        <p class="text-muted text-sm m-0">
                            Turn on the trackers you want and put them in order. The order sets the Track
                            tabs, your Today cards, and the + menu. Your choice is encrypted and synced to
                            your devices — only you can read it.
                        </p>
                        <p aria-live="polite" class="sr-only">@_navStatus</p>
                        @{
                            var navItems = NavPrefs.EditorItems();
                        }
                        <ul class="list-none p-0 m-0 space-y-2 pt-1">
                            @for (var idx = 0; idx < navItems.Count; idx++)
                            {
                                var item = navItems[idx];
                                var i = idx;
                                var hidden = NavPrefs.IsHidden(item.Key);
                                <li class="flex items-center gap-2 rounded-bubble px-3 py-2"
                                    style="background:var(--color-surface-2); border:1px solid var(--color-line);">
                                    <span class="inline-flex items-center justify-center w-9 h-9 rounded-full shrink-0"
                                          style="color:var(--color-primary); background:var(--color-primary-soft)" aria-hidden="true">
                                        <NavIcon Name="@item.Icon" Size="20" />
                                    </span>
                                    <span class="font-semibold flex-1 min-w-0 @(hidden ? "opacity-50" : "")">@item.Label</span>
                                    <button type="button" id="nav-up-@item.Key" class="nav-ctl" aria-label="Move @item.Label up"
                                            disabled="@(i == 0)" @onclick="() => MoveNav(item.Key, item.Label, -1)">↑</button>
                                    <button type="button" id="nav-down-@item.Key" class="nav-ctl" aria-label="Move @item.Label down"
                                            disabled="@(i == navItems.Count - 1)" @onclick="() => MoveNav(item.Key, item.Label, 1)">↓</button>
                                    <label class="inline-flex items-center justify-center cursor-pointer shrink-0 min-w-[2.75rem] min-h-[2.75rem]">
                                        <input type="checkbox" checked="@(!hidden)"
                                               @onchange="e => ToggleNav(item.Key, item.Label, (bool)e.Value!)" />
                                        <span class="sr-only">Use the @item.Label tracker</span>
                                    </label>
                                </li>
                            }
                        </ul>
                        <button type="button" class="btn btn-ghost" @onclick="ResetNav">Reset to default</button>
                    </div>
                </details>

                <section aria-labelledby="faith-heading" class="space-y-2">
                    <h2 id="faith-heading" class="text-base font-bold m-0">Faith &amp; belief <span class="text-muted font-normal text-sm">(optional)</span></h2>
                    <p class="text-muted text-sm m-0">
                        Weave gently-worded, cited passages from a tradition into your tips and home page.
                        Your choice is encrypted — only you can see it.
                    </p>
                    @if (!Crypto.IsUnlocked)
                    {
                        <VaultGate OnUnlocked="OnFaithUnlocked" />
                    }
                    else
                    {
                        <div class="space-y-2 pt-1">
                            @foreach (var t in AllTraditions)
                            {
                                var available = FaithLibrary.Available.Contains(t);
                                <label class="flex items-center gap-2 min-h-[2.75rem] @(available ? "" : "opacity-60")">
                                    <input type="checkbox" disabled="@(!available)"
                                           checked="@Faith.Selected.Contains(t)"
                                           @onchange="e => ToggleTradition(t, (bool)e.Value!)" />
                                    <span class="font-semibold">@FaithLibrary.DisplayName(t)</span>
                                    @if (!available)
                                    {
                                        <span class="text-xs text-muted">(coming soon)</span>
                                    }
                                </label>
                            }
                        </div>
                    }
                </section>

                <button class="btn btn-block" @onclick="SignOut">Sign out</button>
            </div>
        }
        else if (_sent)
        {
            <h1 class="text-center">Check your email</h1>
            <p class="text-muted text-center">
                We sent a one-time sign-in link from Supabase to <strong>@_email</strong>. Open it on this device
                and you'll land back here, signed in.
            </p>
            <p class="text-muted text-sm text-center">It can take a minute to arrive. Check spam if it's shy.</p>
            <button class="btn btn-ghost btn-block" @onclick="() => _sent = false">Use a different email</button>
        }
        else
        {
            <h1 class="text-center">Welcome</h1>
            <p class="text-muted text-center">
                Enter your email and we'll send you a one-time sign-in link from our partner Supabase.
                No password to remember — or for anyone to steal.
            </p>
            <div class="field">
                <label class="label" for="email">Email</label>
                <input id="email" class="input" type="email" inputmode="email" autocomplete="email"
                       @bind="_email" placeholder="you@example.com" />
            </div>
            @if (_error is not null)
            {
                <p class="text-sm font-semibold m-0" style="color:var(--color-danger)" role="alert">@_error</p>
            }
            <button class="btn btn-primary btn-block" disabled="@_busy" @onclick="Send">
                @(_busy ? "Sending…" : "Email me a sign-in link")
            </button>
            <p class="text-muted text-sm text-center m-0">
                New here? The same link creates your free account. Or
                <a href="journal/new">continue as a guest</a> — nothing saved, ever.
            </p>
        }
    </div>

    @* The site footer is hidden on phones, so its content lives here too. *@
    <section class="card-soft space-y-2 text-sm" aria-labelledby="about-heading">
        <h2 id="about-heading" class="text-base font-bold m-0">About</h2>
        <p class="text-muted m-0">Designed from the ground up for privacy. Your words are yours.</p>
        <p class="text-muted m-0">Built by Dylan Smith and Claude in 2026.</p>
        <p class="m-0">
            <a class="font-semibold" href="https://github.com/drummerboydibs/do-well-to-do-good/issues/new?labels=enhancement&amp;title=Feature%20request:%20"
               target="_blank" rel="noopener noreferrer">Suggest a feature <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </p>
    </section>
</div>

@code {
    private string _email = "";
    private string? _error;
    private bool _busy, _sent;

    private DateTimeOffset? _createdAt;
    private DateTimeOffset? _lastSignIn;

    private record ThemeOption(string Value, string Label, string Icon);
    private readonly ThemeOption[] _themeOptions =
    {
        new(ThemeService.Light, "Light", "☀️"),
        new(ThemeService.Dark, "Dark", "🌙"),
        new(ThemeService.System, "System", "🖥️"),
    };

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsSignedIn)
        {
            try { (_createdAt, _lastSignIn) = await Auth.GetUserMetaAsync(); }
            catch { }
            await Faith.LoadAsync();
        }
    }

    // ----- Navigation editor -----
    [SupplyParameterFromQuery(Name = "trackers")] public string? TrackersFlag { get; set; }

    private string _navStatus = "";       // announced via an aria-live region
    private string? _navFocusId;          // control to refocus after the list re-renders

    private async Task MoveNav(string key, string label, int delta)
    {
        await NavPrefs.MoveAsync(key, delta);
        var items = NavPrefs.EditorItems();
        var idx = items.ToList().FindIndex(i => i.Key == key);
        if (idx < 0) return;

        _navStatus = $"{label} moved to position {idx + 1} of {items.Count}.";
        // Keep focus on a still-enabled arrow (↑ is disabled at the top, ↓ at the bottom).
        _navFocusId = delta < 0
            ? (idx == 0 ? $"nav-down-{key}" : $"nav-up-{key}")
            : (idx == items.Count - 1 ? $"nav-up-{key}" : $"nav-down-{key}");
    }

    private async Task ToggleNav(string key, string label, bool show)
    {
        await NavPrefs.ToggleHiddenAsync(key, !show);
        _navStatus = show ? $"{label} tracker turned on." : $"{label} tracker turned off.";
    }

    private async Task ResetNav()
    {
        await NavPrefs.ResetAsync();
        _navStatus = "Trackers reset: all on, in the default order.";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_navFocusId is null) return;
        var id = _navFocusId;
        _navFocusId = null;
        try { await JS.InvokeVoidAsync("dwtdgUtil.focusById", id); } catch { }
    }

    private static readonly FaithTradition[] AllTraditions = Enum.GetValues<FaithTradition>();

    private async Task ToggleTradition(FaithTradition t, bool on)
    {
        var set = Faith.Selected.ToList();
        if (on) { if (!set.Contains(t)) set.Add(t); }
        else set.Remove(t);
        await Faith.SetAsync(set);
    }

    private async Task OnFaithUnlocked()
    {
        await Faith.LoadAsync(force: true);
        StateHasChanged();
    }

    private async Task SetTheme(string preference) => await Theme.SetAsync(preference);

    private async Task Send()
    {
        _error = null;
        var email = _email.Trim();
        if (email.Length < 5 || !email.Contains('@') || !email.Contains('.'))
        {
            _error = "Please enter a valid email address.";
            return;
        }
        _busy = true;
        try
        {
            var (ok, err) = await Auth.SendMagicLinkAsync(email);
            if (ok) _sent = true;
            else _error = err;
        }
        finally { _busy = false; }
    }

    private async Task SignOut()
    {
        await Crypto.LockAsync();   // wipe the encryption key from memory
        await Auth.SignOutAsync();
        Nav.NavigateTo("");
    }
}
