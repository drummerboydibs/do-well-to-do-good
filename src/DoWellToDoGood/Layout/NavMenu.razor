@* Desktop primary nav — a horizontal pill row. Hidden on phones, where
   BottomNav takes over. Home and Account are fixed anchors; everything in
   between is the user's chosen, ordered, visible set. *@
@implements IDisposable
@inject AuthService Auth
@inject NavPrefsService NavPrefs
@inject NavigationManager Nav

<nav class="hidden sm:flex gap-x-1 gap-y-2 items-center flex-wrap justify-center" aria-label="Primary">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" aria-current="@CurrentMark("")">Home</NavLink>

    @foreach (var item in NavPrefs.VisibleItems(Auth.IsSignedIn))
    {
        <NavLink class="nav-link" href="@item.Href" aria-current="@CurrentMark(item.Href)">@item.Label</NavLink>
    }

    <NavLink class="nav-link" href="signin" aria-current="@CurrentMark("signin")">@(Auth.IsSignedIn ? "Account" : "Sign in")</NavLink>
</nav>

@code {
    private string? CurrentMark(string href)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        return string.Equals(current, href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) ? "page" : null;
    }

    protected override void OnInitialized()
    {
        Auth.Changed += OnChanged;
        NavPrefs.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? _, LocationChangedEventArgs __) => _ = InvokeAsync(StateHasChanged);

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.Changed -= OnChanged;
        NavPrefs.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
