@* Header nav. On desktop: the Today · Journal · Track row, a "+ New" button
   for the create menu, then Get help and Account. On phones the bottom bar
   carries the destinations, so the header keeps only a Get help icon. *@
@implements IDisposable
@inject AuthService Auth
@inject NavigationManager Nav

<nav class="hidden sm:flex gap-x-1 gap-y-2 items-center flex-wrap justify-end" aria-label="Primary">
    @foreach (var item in new[] { NavCatalog.Today, NavCatalog.Journal, NavCatalog.Track })
    {
        <a class="nav-link @(IsCurrent(item.Href) ? "active" : "")" href="@item.Href" aria-current="@Mark(item.Href)">@item.Label</a>
    }
    <span class="px-1"><CreateMenu Variant="button" /></span>
    <a class="nav-link inline-flex items-center gap-1.5 @(IsCurrent("help") ? "active" : "")" href="help" aria-current="@Mark("help")">
        <NavIcon Name="heart" Size="18" /> Get help
    </a>
    <a class="nav-link @(IsAccount ? "active" : "")" href="account" aria-current="@(IsAccount ? "page" : null)">
        @(Auth.IsSignedIn ? "Account" : "Sign in")
    </a>
</nav>

@* Phones: help is always one tap away, right in the header. *@
<a class="help-icon sm:hidden @(IsCurrent("help") ? "active" : "")" href="help" aria-label="Get help" aria-current="@Mark("help")">
    <NavIcon Name="heart" Size="22" />
</a>

@code {
    private string Path => Nav.ToBaseRelativePath(Nav.Uri);

    private bool IsCurrent(string href) => NavCatalog.IsCurrent(Path, href);
    private string? Mark(string href) => IsCurrent(href) ? "page" : null;
    private bool IsAccount => IsCurrent("account") || IsCurrent("signin");

    protected override void OnInitialized()
    {
        Auth.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? _, LocationChangedEventArgs __) => OnChanged();

    public void Dispose()
    {
        Auth.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
