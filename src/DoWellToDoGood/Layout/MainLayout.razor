@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="flex flex-col min-h-screen relative has-bottom-nav">

    <div class="bubbles" aria-hidden="true">
        <span class="bubble"></span>
        <span class="bubble"></span>
        <span class="bubble"></span>
        <span class="bubble"></span>
        <span class="bubble"></span>
        <span class="bubble"></span>
        <span class="bubble"></span>
        <span class="bubble"></span>
        <span class="bubble"></span>
        <span class="bubble"></span>
    </div>

    <header class="sticky top-0 z-10 border-b border-line app-bar backdrop-blur">
        <div class="shell py-3 flex items-center justify-between gap-4">
            <a class="inline-flex items-center gap-2 no-underline shrink-0" href="">
                <img class="w-7 h-7 shrink-0 drop-shadow-sm" src="icons/icon.svg" alt="" width="28" height="28" />
                <span class="brand-word text-lg sm:text-xl whitespace-nowrap">do <span class="brand-well">well</span> to do <span class="brand-good">good</span></span>
            </a>
            <NavMenu />
        </div>
    </header>

    <main id="main-content" class="relative flex-1 py-6 sm:py-12 overflow-x-clip">
        @Body
    </main>

    @* Hidden on phones — its links live under Account → About there. *@
    <footer class="relative border-t border-line mt-12 py-6 app-bar app-bar--soft backdrop-blur hidden sm:block">
        <div class="shell flex items-center justify-between gap-4 flex-wrap">
            <div class="text-muted text-sm space-y-1">
                <p class="m-0">Designed from the ground up for privacy. Your words are yours.</p>
                <p class="m-0">Built by Dylan Smith and Claude in 2026.</p>
            </div>
            <div class="flex items-center gap-4 flex-wrap">
                <a class="font-semibold" href="https://github.com/drummerboydibs/do-well-to-do-good/issues/new?labels=enhancement&amp;title=Feature%20request:%20"
                   target="_blank" rel="noopener noreferrer">Suggest a feature <span aria-hidden="true">↗</span></a>
            </div>
        </div>
    </footer>

    <BottomNav />

    @* Outside the header and bottom bar on purpose: their backdrop blur would
       otherwise become the containing block for the fixed-position sheet. *@
    <CreateSheet />

</div>
