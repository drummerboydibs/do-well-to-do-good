@* Mobile primary nav — a fixed five-slot bottom bar, shown only on phones
   (sm:hidden): Today · Journal · New (create menu) · Track · Account. Fixed
   slots, so nothing overflows into a "More" sheet. Get help lives in the
   header. *@
@implements IDisposable
@inject AuthService Auth
@inject NavigationManager Nav

<nav class="bottom-nav sm:hidden" aria-label="Primary">
    @Tab(NavCatalog.Today)
    @Tab(NavCatalog.Journal)
    <CreateMenu Variant="bar" />
    @Tab(NavCatalog.Track)
    @Tab(NavCatalog.Account with { ShortLabel = Auth.IsSignedIn ? "Account" : "Sign in" })
</nav>

@code {
    private RenderFragment Tab(NavItem item) =>
        @<a class="bottom-nav-item @(IsCurrent(item) ? "active" : "")" href="@item.Href" aria-current="@(IsCurrent(item) ? "page" : null)">
            <NavIcon Name="@item.Icon" Size="22" />
            <span>@item.ShortLabel</span>
        </a>;

    // Account answers to both of its routes.
    private bool IsCurrent(NavItem item)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        return NavCatalog.IsCurrent(path, item.Href)
            || (item.Key == "account" && NavCatalog.IsCurrent(path, "signin"));
    }

    protected override void OnInitialized()
    {
        Auth.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? _, LocationChangedEventArgs __) => OnChanged();

    public void Dispose()
    {
        Auth.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
